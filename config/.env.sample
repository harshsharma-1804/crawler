# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=crawler_platform

# ── Storage ───────────────────────────────────────────────────────────────────
# Root directory for all crawled data (HTML, assets, analyses, server mirrors)
# Set this to an absolute path on your machine — it will be created automatically.
DATA_DIR=/path/to/your/data
MAX_FILE_SIZE_MB=100

# ── Crawler limits ────────────────────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=50
MAX_DEPTH=5
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
RATE_LIMIT_PER_DOMAIN=10
MAX_PARALLEL_JOBS=3

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── Playwright browser ────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium

# ── Caching ───────────────────────────────────────────────────────────────────
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
USE_UVLOOP=true

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random string for production (e.g. openssl rand -hex 32)
VERIFICATION_TOKEN_SECRET=change-me-in-production
ADMIN_EMAIL_DOMAIN=localhost
